// The Worker config of the playground's pull request previews: the preview job in
// .github/workflows/pages.yml deploys preview-out/ with --name jsonvet-playground-pr-<number>.
// Production is GitHub Pages, not a Worker.
{
  "name": "jsonvet-playground",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./preview-out"
  },
  // Off, so the workers.dev address is a Worker's only one, and the retire job can
  // check that one address after the delete.
  "preview_urls": false,
  "workers_dev": true
}
