// Which versions Renovate bumps and which stay fixed: docs/design.md, "Dependencies and pins".
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Pins Actions and Docker images by digest, with the version in a comment or tag.
  extends: ["config:best-practices", ":semanticCommits", "schedule:monthly"],
  // Cargo.lock already fixes what the tests ran with; exact pins in Cargo.toml would add nothing.
  ignorePresets: [":pinDevDependencies"],
  // A compromised release is usually caught and yanked within a week.
  minimumReleaseAge: "7 days",
  internalChecksFilter: "strict",
  // The hook placeholder pins jsonvet's own version, which the release sets.
  ignorePaths: ["setup.py", "tests/**"],
  "pre-commit": { enabled: true },
  customManagers: [
    {
      // Python tools run with uvx in CI: the pre-commit and prek the hook is tested with. ruff's
      // pin is the hook rev in .pre-commit-config.yaml, which CI runs.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/.+\\.yml$/"],
      matchStrings: ["(?<depName>pre-commit|prek)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      datasourceTemplate: "pypi",
    },
    {
      // Cargo tools installed by taiki-e/install-action.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/.+\\.yml$/"],
      matchStrings: ["(?<depName>cargo-(?:cyclonedx|deny|fuzz|llvm-cov|mutants|nextest|semver-checks))@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      datasourceTemplate: "crate",
    },
    {
      // The images maturin builds the Linux wheels in, pinned by tag and digest.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/.+\\.yml$/"],
      matchStrings: ["container: (?<depName>[a-z0-9./_-]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]+)"],
      datasourceTemplate: "docker",
    },
    {
      // The Rust that builds the released wheels. Lint and tests float on stable instead.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/.+\\.yml$/"],
      matchStrings: ['RELEASE_RUST: "(?<currentValue>\\d+\\.\\d+\\.\\d+)"'],
      depNameTemplate: "rust-lang/rust",
      datasourceTemplate: "github-releases",
    },
    {
      // The uv the workflows set up. mise.toml pins it too, and the "uv" group below joins them.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/.+\\.yml$/"],
      matchStrings: ['PINNED_UV: "(?<currentValue>\\d+\\.\\d+\\.\\d+)"'],
      depNameTemplate: "astral-sh/uv",
      datasourceTemplate: "github-releases",
    },
    {
      // The images the conformance drivers run in.
      customType: "regex",
      managerFilePatterns: ["/^conformance/run\\.py$/"],
      matchStrings: ['image="(?<depName>[a-z]+):(?<currentValue>[^@"]+)@(?<currentDigest>sha256:[0-9a-f]+)"'],
      datasourceTemplate: "docker",
    },
  ],
  lockFileMaintenance: { enabled: true },
  packageRules: [
    {
      // One pull request a month for everything outside the matrix; majors stay separate.
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest", "lockFileMaintenance"],
      groupName: "dependencies",
    },
    {
      // A lock refresh has no release date to age against, so the minimumReleaseAge above would
      // hold it at renovate/stability-days for good. Cargo has no release-age setting of its own,
      // so the refresh can take a crate published that day: the PR waits for review, never merges
      // itself.
      matchUpdateTypes: ["lockFileMaintenance"],
      minimumReleaseAge: null,
    },
    {
      // uv in CI and mise.toml, and uv_build, which builds check-json5: one pull request, so the
      // backend stays at the version of the uv that runs it.
      matchPackageNames: ["uv", "astral-sh/uv", "uv_build", "uv-build"],
      groupName: "uv",
    },
    {
      // The matrix's parsers and images: pinned exactly, bumped once a quarter, never merged
      // without a re-run. CI's `run.py --check` fails until results/versions.json matches.
      matchFileNames: ["conformance/**"],
      groupName: "conformance parsers",
      schedule: ["* 0-3 1 1,4,7,10 *"],
      rangeStrategy: "pin",
      automerge: false,
      prBodyNotes: [
        "Re-run the matrix before merging: `uv run conformance/run.py && uv run conformance/report.py`, then commit the results.",
      ],
    },
    {
      // Their lock files hold what the results were produced with; refresh them only with a run.
      matchFileNames: ["conformance/**"],
      matchUpdateTypes: ["lockFileMaintenance"],
      enabled: false,
    },
    {
      // The Rust toolchains in CI: stable and nightly float by design, and the msrv job's is the
      // minimum supported Rust, a policy that changes with rust-version in Cargo.toml, not with
      // releases.
      matchManagers: ["github-actions"],
      matchDepNames: ["rust"],
      enabled: false,
    },
    {
      // The Go driver's minimum Go; the image tag decides which Go builds it.
      matchManagers: ["gomod"],
      matchDepNames: ["go"],
      enabled: false,
    },
    {
      // The check-json5 package pins jsonvet's own version, which the release sets. Its build
      // backend, uv_build, is bumped in the uv group.
      matchFileNames: ["compat/**"],
      matchPackageNames: ["jsonvet"],
      enabled: false,
    },
    {
      // The contract reference for the differential tests: jsonvet must match this exact release.
      matchPackageNames: ["check-json5"],
      enabled: false,
    },
  ],
}
