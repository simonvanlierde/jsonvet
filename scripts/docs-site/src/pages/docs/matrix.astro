---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { matrixPage } from "../../../matrix.mjs";
import "../../styles/matrix.css";

const { title, summary, body } = matrixPage();
---

<StarlightPage frontmatter={{ title, description: summary, tableOfContents: false, pagefind: false }}>
  <Fragment set:html={body} />
</StarlightPage>

<script>
  // A horizontal scroll container would stop the header sticking to the page.
  const fit = new ResizeObserver((entries) => {
    for (const { target } of entries) {
      const scroll = target.closest(".scroll");
      const table = scroll?.querySelector("table");
      if (table && scroll) scroll.toggleAttribute("data-fits", scroll.clientWidth >= table.offsetWidth);
    }
  });
  for (const scroll of document.querySelectorAll(".matrix .tables .scroll")) {
    const table = scroll.querySelector("table");
    if (table) {
      fit.observe(scroll);
      fit.observe(table);
    }
  }

  type Opener = { dialect: string; filter: string; hash: string };
  const matrix = document.querySelector("#matrix");

  const restore = ({ dialect, filter, hash }: Opener) => {
    const table = document.getElementById(`dialect-${dialect}`);
    const returnTo = [...(table?.querySelectorAll<HTMLAnchorElement>("table a") ?? [])]
      .find((anchor) => anchor.hash === hash);
    const dialectRadio = matrix?.querySelector<HTMLInputElement>(`[name="dialect"][value="${CSS.escape(dialect)}"]`);
    const filterRadio = table?.querySelector<HTMLInputElement>(`.filter [value="${CSS.escape(filter)}"]`);
    if (dialectRadio) dialectRadio.checked = true;
    if (filterRadio) filterRadio.checked = true;
    returnTo?.focus({ preventScroll: true });
    returnTo?.scrollIntoView({ block: "nearest", inline: "nearest" });
  };

  window.addEventListener("popstate", (event) => {
    const opener: Opener | undefined = event.state?.matrixReturn;
    requestAnimationFrame(() => {
      if (opener) restore(opener);
      else matrix?.querySelector<HTMLElement>(".detail:target")?.focus({ preventScroll: true });
    });
  });

  matrix?.addEventListener("click", (event) => {
    if (!(event instanceof MouseEvent) || event.button !== 0 || event.altKey || event.ctrlKey ||
        event.metaKey || event.shiftKey || !(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>("a[href^='#']");
    if (!link) return;
    const section = link.closest(".dialect");
    let opener: Opener | undefined = history.state?.matrixOpener;
    if (section) {
      opener = {
        dialect: section.id.slice("dialect-".length),
        filter: section.querySelector<HTMLInputElement>(".filter input:checked")?.value ?? "all",
        hash: link.hash,
      };
      if (location.hash !== link.hash) {
        history.replaceState({ ...history.state, matrixReturn: opener }, "");
      }
    }
    if (!opener) return;
    const afterNavigation = () => {
      if (location.hash !== link.hash) return;
      if (link.closest(".back")) {
        history.replaceState({ ...history.state, matrixReturn: opener }, "");
        restore(opener);
      } else if (section || link.closest(".detail")) {
        // Keep the table opener when a reader follows links between detail panels.
        history.replaceState({ ...history.state, matrixOpener: opener }, "");
      }
    };
    if (location.hash === link.hash) afterNavigation();
    else window.addEventListener("hashchange", afterNavigation, { once: true });
  });
</script>
