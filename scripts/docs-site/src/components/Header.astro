---
// The playground's header (playground/header.html), with the search where its marker is.
import Search from "virtual:starlight/components/Search";
import { chrome, DOCS, QUICK_START, ruleIds } from "../../lib.mjs";
const [before, after] = chrome("header.html").split("<!--search-->");
const reference = DOCS + "usage.html";
const directResults = [
  ["install jsonvet", { href: QUICK_START, label: "Install jsonvet" }],
  ["sarif", { href: reference + "#sarif", label: "SARIF output and code scanning" }],
  ["gitlab", { href: reference + "#gitlab-code-quality", label: "GitLab Code Quality" }],
  ["gitlab code quality", { href: reference + "#gitlab-code-quality", label: "GitLab Code Quality" }],
  ...ruleIds().map((rule) => [rule, { href: `${reference}#${encodeURIComponent(rule)}`, label: `Rule reference: ${rule}` }]),
];
---

<div class="bar">
  <Fragment set:html={before} />
  <div class="docs-search" data-direct-results={JSON.stringify(directResults)}>
    <Search />
  </div>
  <Fragment set:html={after} />
</div>

<script>
  const search = document.querySelector<HTMLElement>(".docs-search");
  const button = search?.querySelector<HTMLButtonElement>("[data-open-modal]");
  const dialog = search?.querySelector("dialog");

  if (search && button && dialog) {
    const directResults = new Map<string, { href: string; label: string }>(
      JSON.parse(search.dataset.directResults ?? "[]"),
    );
    const shortcut = button.querySelector("kbd");
    if (shortcut) {
      shortcut.setAttribute("aria-hidden", "true");
      search.append(shortcut);
    }
    button.setAttribute("aria-keyshortcuts", `${button.getAttribute("aria-keyshortcuts")} /`);

    document.addEventListener("keydown", (event) => {
      if (dialog.open || button.disabled) return;
      if (event.key === "k" && (event.ctrlKey || event.metaKey)) {
        // Starlight's window listener opens the dialog and the browser records focus.
        if (document.activeElement === document.body) button.focus();
        return;
      }
      if (event.key !== "/" || event.ctrlKey || event.metaKey || event.altKey ||
          (event.target instanceof Element && event.target.closest("input,textarea,select,[contenteditable]"))) return;
      event.preventDefault();
      if (document.activeElement === document.body) button.focus();
      button.click();
    });

    // Pagefind's fuzzy results follow the direct match for a task or rule.
    const result = document.createElement("p");
    result.className = "direct-result";
    result.setAttribute("aria-live", "polite");
    const link = document.createElement("a");
    dialog.addEventListener("input", (event) => {
      const input = event.target;
      if (!(input instanceof HTMLInputElement) || !input.matches(".pagefind-ui__search-input")) return;
      const match = directResults.get(input.value.trim().toLowerCase());
      if (!match) {
        result.remove();
        return;
      }
      link.href = match.href;
      link.textContent = match.label;
      result.replaceChildren(link);
      input.form?.querySelector(".pagefind-ui__drawer")?.before(result);
    });
    dialog.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest(".pagefind-ui__search-clear")) result.remove();
    });
    dialog.addEventListener("close", () => {
      const input = dialog.querySelector<HTMLInputElement>(".pagefind-ui__search-input");
      if (!input?.value.trim()) result.remove();
    });
    dialog.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" || !result.isConnected ||
          !(event.target instanceof HTMLInputElement) || !event.target.matches(".pagefind-ui__search-input")) return;
      event.preventDefault();
      link.click();
    });
  }
</script>
