# Line endings in the corpus are test data; git must not convert them.
tests/corpus/** -text
# So are the extra conformance inputs, and the SchemaStore files as copied.
conformance/extra/** -text
tests/schemastore/** -text

# Generated or recorded output: GitHub collapses these in a diff, and pr-size.yml leaves them
# out of its changed-line count.
Cargo.lock linguist-generated=true
package-lock.json linguist-generated=true
pnpm-lock.yaml linguist-generated=true
*.snap linguist-generated=true
*.proptest-regressions linguist-generated=true
