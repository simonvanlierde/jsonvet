{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/simonvanlierde/jsonvet/blob/main/docs/json-output.schema.json",
  "title": "jsonvet --format json",
  "description": "The document jsonvet prints for --format json. Fields not listed here may come in a later release without a new schema_version: ignore them.",
  "type": "object",
  "required": ["schema_version", "diagnostics"],
  "properties": {
    "schema_version": {
      "description": "The version of this layout.",
      "const": 2
    },
    "diagnostics": {
      "description": "One object per problem, in the order text output prints them.",
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "errors": {
      "description": "Why the run stopped on a usage error or a bad schema, before any diagnostic was printed. In a --format jsonl summary record, an error can also follow other records.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["message", "help"],
        "properties": {
          "message": { "type": "string" },
          "help": { "description": "What to do next.", "type": "string" }
        }
      }
    },
    "notes": {
      "description": "Runtime notices, such as a missing local schema or a stale catalog cache. These do not change the exit status.",
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "record": {
      "description": "One line of --format jsonl, which shares schema_version with --format json.",
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/diagnostic" },
            { "properties": { "type": { "const": "diagnostic" } } }
          ],
          "required": ["type", "schema_version"],
          "properties": { "schema_version": { "const": 2 } }
        },
        {
          "description": "A file once its diagnostics are reported.",
          "type": "object",
          "required": ["type", "schema_version", "file", "error_count", "warning_count"],
          "properties": {
            "type": { "const": "file" },
            "schema_version": { "const": 2 },
            "file": { "type": "string" },
            "error_count": { "type": "integer", "minimum": 0 },
            "warning_count": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "description": "The last record. The counts are left out when the run stopped on an error, with exit_code 2 and errors.",
          "type": "object",
          "required": ["type", "schema_version", "exit_code"],
          "properties": {
            "type": { "const": "summary" },
            "schema_version": { "const": 2 },
            "files": { "type": "integer", "minimum": 0 },
            "files_with_problems": { "type": "integer", "minimum": 0 },
            "error_count": { "type": "integer", "minimum": 0 },
            "warning_count": { "type": "integer", "minimum": 0 },
            "exit_code": { "enum": [0, 1, 2] },
            "errors": { "$ref": "#/properties/errors" },
            "notes": { "$ref": "#/properties/notes" }
          }
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "file",
        "rule",
        "url",
        "severity",
        "message",
        "line",
        "column",
        "offset",
        "related"
      ],
      "properties": {
        "file": {
          "description": "The file name as given, or the --stdin-filename.",
          "type": "string"
        },
        "rule": {
          "description": "The rule id, such as duplicate-key, or schema or unreadable.",
          "type": "string"
        },
        "url": {
          "description": "A link to the rule's section in docs/usage.md.",
          "type": "string",
          "format": "uri"
        },
        "severity": { "enum": ["error", "warning"] },
        "message": { "type": "string" },
        "path": {
          "description": "Optional RFC 9535 normalized JSONPath for the value named by a schema diagnostic. For JSON Lines, the root is the record on the reported line.",
          "type": "string"
        },
        "line": {
          "description": "From 1; null for a file jsonvet could not read.",
          "type": ["integer", "null"],
          "minimum": 1
        },
        "column": {
          "description": "From 1, in code points; null with no line.",
          "type": ["integer", "null"],
          "minimum": 1
        },
        "offset": {
          "description": "The byte offset in the file, from 0; null with no line.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "related": {
          "description": "Other places the problem names. Often empty.",
          "type": "array",
          "items": { "$ref": "#/$defs/related" }
        }
      }
    },
    "related": {
      "type": "object",
      "required": ["message", "line", "column", "offset"],
      "properties": {
        "message": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "offset": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
