from typing import Never, final

@final
class Diagnostic:
    def __new__(cls, _not_constructible: Never, /) -> Diagnostic: ...
    @property
    def severity(self) -> str: ...
    @property
    def rule(self) -> str: ...
    @property
    def message(self) -> str: ...
    @property
    def line(self) -> int: ...
    @property
    def column(self) -> int: ...
    @property
    def byte_offset(self) -> int: ...
    @property
    def byte_end(self) -> int: ...

def check(text: str, *, dialect: str = "json") -> list[Diagnostic]: ...
