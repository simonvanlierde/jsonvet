---
source: crates/jsonvet/tests/format.rs
expression: "show(Dialect::Jwcc, &FormatOptions::default(),\n&[\"{\\\"a\\\": 1, \\\"b\\\": [1, 2,],}\", \"{\\n\\\"a\\\": 1,\\n// c\\n\\\"b\\\": 2,\\n}\",\n\"[\\n  1,\\n  2, // two\\n]\", \"[1 /* x */,]\",])"
---
jwcc FormatOptions { indent: Spaces(2), width: 80, normalize_json5: false, bracket_spacing: true, fill_numbers: false }
--- in
{"a": 1, "b": [1, 2,],}
--- out
{ "a": 1, "b": [1, 2] }

=== "{ \"a\": 1, \"b\": [1, 2] }\n"

jwcc FormatOptions { indent: Spaces(2), width: 80, normalize_json5: false, bracket_spacing: true, fill_numbers: false }
--- in
{
"a": 1,
// c
"b": 2,
}
--- out
{
  "a": 1,
  // c
  "b": 2,
}

=== "{\n  \"a\": 1,\n  // c\n  \"b\": 2,\n}\n"

jwcc FormatOptions { indent: Spaces(2), width: 80, normalize_json5: false, bracket_spacing: true, fill_numbers: false }
--- in
[
  1,
  2, // two
]
--- out
[
  1,
  2, // two
]

=== "[\n  1,\n  2, // two\n]\n"

jwcc FormatOptions { indent: Spaces(2), width: 80, normalize_json5: false, bracket_spacing: true, fill_numbers: false }
--- in
[1 /* x */,]
--- out
[
  1 /* x */,
]

=== "[\n  1 /* x */,\n]\n"
