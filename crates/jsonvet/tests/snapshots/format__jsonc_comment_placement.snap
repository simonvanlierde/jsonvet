  "a": 1, // after the comma
  // own line
  "b": [1, 2, 3], /* block after */
  "c": 4 // last, no comma
}

=== "{ // after the brace\n  \"a\": 1, // after the comma\n  // own line\n  \"b\": [1, 2, 3], /* block after */\n  \"c\": 4 // last, no comma\n}\n"

jsonc FormatOptions { indent: Spaces(2), width: 80, normalize_json5: false, bracket_spacing: true, fill_numbers: false }
