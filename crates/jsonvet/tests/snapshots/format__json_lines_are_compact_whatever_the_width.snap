---
source: crates/jsonvet/tests/format.rs
expression: "show(Dialect::JsonLines, &width(10),\n&[\"{\\\"a\\\":1,\\\"b\\\":[1,2,{\\\"c\\\":null}]}\\n[1,2,3]\\n\\\"x\\\"\\n\",\n\"{\\\"a\\\":1}\\n\\n   \\n{\\\"b\\\":2}\", \"  {  \\\"a\\\" :  1  }  \\r\\n[ ]\\r\\n\", \"\",\n\"{\\\"a\\\":\\n1}\\n\",])"
---
jsonl FormatOptions { indent: Spaces(2), width: 10, normalize_json5: false, bracket_spacing: true }
--- in
{"a":1,"b":[1,2,{"c":null}]}
[1,2,3]
"x"

--- out
{"a": 1, "b": [1, 2, {"c": null}]}
[1, 2, 3]
"x"

=== "{\"a\": 1, \"b\": [1, 2, {\"c\": null}]}\n[1, 2, 3]\n\"x\"\n"

jsonl FormatOptions { indent: Spaces(2), width: 10, normalize_json5: false, bracket_spacing: true }
--- in
{"a":1}

   
{"b":2}
--- out
syntax error: blank line; JSON Lines needs a value on every line
=== "syntax error: blank line; JSON Lines needs a value on every line"

jsonl FormatOptions { indent: Spaces(2), width: 10, normalize_json5: false, bracket_spacing: true }
--- in
  {  "a" :  1  }  
[ ]

--- out
{"a": 1}
[]

=== "{\"a\": 1}\r\n[]\r\n"

