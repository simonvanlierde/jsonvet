---
source: crates/jsonvet/tests/format.rs
expression: "show(Dialect::Json5, &normalized(),\n&[\"{a: 'single', \\\"b\\\": \\\"double\\\", 'c': 0x1F, d: +1, e: .5,}\",\n\"{'it\\\\'s': 'say \\\"hi\\\"', \\\"a-b\\\": 1, \\\"\\\": 2, \\\"1a\\\": 3, \\\"ok_$\\\": 4, \\\"\\\\u0061\\\": 5}\",\n\"{a: [1, 2,], b: {c: 1,},}\", \"{a: 1, // c\\n b: 2}\", \"[\\n1, 2]\",\n\"{\\\"aaaaaaaaaaaaaaaaaaa\\\": [1111111111, 2222222222, 3333333333], \\\"bbbbbbbbbbbbbbbbbbbbbbbbb\\\": 1}\",\n\"[]\", \"{ // only\\n}\",])"
---
json5 FormatOptions { indent: Spaces(2), width: 80, normalize_json5: true, bracket_spacing: true, fill_numbers: false }
--- in
{a: 'single', "b": "double", 'c': 0x1F, d: +1, e: .5,}
--- out
{ a: "single", b: "double", c: 0x1F, d: +1, e: .5 }

=== "{ a: \"single\", b: \"double\", c: 0x1F, d: +1, e: .5 }\n"

json5 FormatOptions { indent: Spaces(2), width: 80, normalize_json5: true, bracket_spacing: true, fill_numbers: false }
--- in
{'it\'s': 'say "hi"', "a-b": 1, "": 2, "1a": 3, "ok_$": 4, "\u0061": 5}
--- out
{ "it's": "say \"hi\"", "a-b": 1, "": 2, "1a": 3, ok_$: 4, "\u0061": 5 }

=== "{ \"it's\": \"say \\\"hi\\\"\", \"a-b\": 1, \"\": 2, \"1a\": 3, ok_$: 4, \"\\u0061\": 5 }\n"

json5 FormatOptions { indent: Spaces(2), width: 80, normalize_json5: true, bracket_spacing: true, fill_numbers: false }
