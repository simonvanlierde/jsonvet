---
source: crates/jsonvet/tests/cases.rs
expression: "snapshot(&[(Json, r#\"{\"a\": 1, \"a\": 2}\"#),\n(Json,\n\"{\\n  \\\"x\\\": {\\\"a\\\": 1, \\\"\\\\u0061\\\": 2},\\n  \\\"l\\\": [{\\\"k\\\": 1}, {\\\"k\\\": 2, \\\"k\\\": 3}],\\n  \\\"x\\\": 0\\n}\"),\n(Json5, \"{a: 1, 'a': 2, \\\"b c\\\": {d: 1, d: 2}, \\\\u0061: 3}\"),\n(Json5, \"{\\\"ünicode\\\": 1, \\\"ünicode\\\": 2}\"),\n(Json, r#\"{\"\\ud800\": 1, \"\\udbff\": 2, \"\\ufffd\": 3, \"a\\udc00\": 4}\"#),\n(Json, r#\"{\"\\ud800\": 1, \"\\uD800\": 2, \"\\ud83d\\ude00\": 3, \"😀\": 4}\"#),\n(Json, r#\"{\"\\ud800\": 1, \"\\ud801\": 2}\"#),\n(Json,\nr#\"{\"\\u0041\\udc00\": 1, \"A\\udc00\": 2, \"\\ud800\\u0041\": 3, \"\\ud800A\": 4}\"#),\n(Json, r#\"{\"\\u00e9\": 1, \"é\": 2, \"\\u4e2d\": 3, \"中\": 4}\"#),\n(Json, r#\"{\"\\n\": 1, \"n\": 2, \"\\/\": 3, \"/\": 4}\"#),\n(Json5, r#\"{\"\\v\": 1, \"v\": 2, \"\\0\": 3, \"0\": 4, \"\\'\": 5, \"'\": 6}\"#),\n(Json5, r#\"{\"\\é\": 1, \"é\": 2, \"\\q\": 3, \"q\": 4}\"#),\n(Json5, r#\"{\"\\x41b\": 1, \"Ab\": 2}\"#),\n(Json5, \"{\\\"a\\\\\\nb\\\": 1, \\\"a\\\\\\r\\nb\\\": 2, \\\"a\\\\\\u{2028}b\\\": 3, \\\"ab\\\": 4}\"),\n(IJson, r#\"{\"a\": 1, \"a\": 2}\"#), (Json, r#\"[{\"a\": 1, \"a\": 2}, {\"\\x\": 0}]\"#),])"
---
json "{\"a\": 1, \"a\": 2}"
       1:10 error[duplicate-key] duplicate key $.a (from 1:2)
json "{\n  \"x\": {\"a\": 1, \"\\u0061\": 2},\n  \"l\": [{\"k\": 1}, {\"k\": 2, \"k\": 3}],\n  \"x\": 0\n}"
